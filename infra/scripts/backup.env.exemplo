# =============================================================================
# CHIRON | Configuração do backup diário da VM pública (modelo)
#
# Na VM, a partir de /opt/chiron:
#   cp infra/scripts/backup.env.exemplo .env.backup
#   chmod 600 .env.backup
#   nano .env.backup
#   bash infra/scripts/backup-vm.sh            # primeiro teste, à mão
#   bash infra/scripts/backup-vm.sh --agendar  # todo dia às 03:10 de Brasília
#
# O .env.backup não entra no git (.gitignore cobre .env.*). Passo a passo em
# docs/DEPLOY_GRATUITO.md, seção "Backup diário".
# =============================================================================

# Chave PÚBLICA do age (começa com age1). A privada nunca fica na VM: fica no
# gerenciador de senhas e numa cópia offline, longe do bucket de backup.
BACKUP_AGE_PUBLIC_KEY=age1COLE_AQUI_A_CHAVE_PUBLICA

# ---------------------------------- destino: Backblaze B2 (10 GB grátis, sem cartão)
# Bucket privado criado no painel do B2 e chave de aplicação restrita a ele.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=COLE_AQUI_O_keyID
RCLONE_CONFIG_B2_KEY=COLE_AQUI_A_applicationKey
# A retenção apaga arquivos antigos. Sem isto o B2 só os esconde, e as versões
# ocultas continuam ocupando os 10 GB.
RCLONE_CONFIG_B2_HARD_DELETE=true
BACKUP_REMOTE=b2:NOME-DO-BUCKET/prod

# ------------------- alternativa: Cloudflare R2 (10 GB grátis; ativar pede cartão ou PayPal)
# Para usar, comente o bloco do B2 acima e descomente este.
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://ID-DA-CONTA.r2.cloudflarestorage.com
# RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# BACKUP_REMOTE=r2:NOME-DO-BUCKET/prod

# ---------------------------------------------- aviso de backup feito (opcional)
# URL de ping de um monitor de cron, por exemplo um check do healthchecks.io
# (plano gratuito com 20 checks). Sem ping no horário, o monitor avisa.
BACKUP_HEARTBEAT_URL=

# ------------------------------------------------------------------- retenção
# Padrão do backup.sh: 30 diários e 12 mensais. Para 1 a 3 clínicas o dump
# cifrado tem poucos MB, e os 10 GB sobram por anos.
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12
