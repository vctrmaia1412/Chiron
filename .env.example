# ---------------------------------------------------------------- ambiente
NODE_ENV=development
APP_ENV=dev
PORT=3333
HOST=0.0.0.0

# ------------------------------------------------------------------ banco
# Papéis distintos por responsabilidade (documento, seções 9.13 e 10.3)
DATABASE_URL=postgres://chiron_app:chiron_dev_password@localhost:5433/chiron
DATABASE_IAM_URL=postgres://chiron_iam:chiron_dev_password@localhost:5433/chiron
DATABASE_ADMIN_URL=postgres://chiron_admin:chiron_dev_password@localhost:5433/chiron
DATABASE_MIGRATION_URL=postgres://chiron_owner:chiron_dev_password@localhost:5433/chiron
DATABASE_POOL_MAX=10
# Senha dos papéis da aplicação, aplicada pela migração. Obrigatória fora de
# desenvolvimento e precisa bater com a senha usada nas URLs acima.
DATABASE_ROLE_PASSWORD=chiron_dev_password

# ------------------------------------------------------------------ redis
REDIS_URL=redis://:chiron_dev_password@localhost:6380

# ---------------------------------------------------------------- storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chiron
S3_ACCESS_KEY=chiron_minio
S3_SECRET_KEY=chiron_dev_password
S3_FORCE_PATH_STYLE=true
FILES_PUBLIC_HOST=http://localhost:9000

# ------------------------------------------------------------------- app
PUBLIC_APP_URL=http://localhost:3000
API_PREFIX=/api/v1
# Origens extras aceitas além de PUBLIC_APP_URL, separadas por vírgula.
EXTRA_ALLOWED_ORIGINS=

# --------------------------------------------------------------- segredos
# Em produção: gerar com `openssl rand -base64 48` e guardar fora do git.
SESSION_SECRET=dev_session_secret_change_me_0123456789abcdef
COLUMN_ENCRYPTION_KEY=dev_column_key_change_me_0123456789abcdefghij
COLUMN_HASH_KEY=dev_hash_key_change_me_0123456789abcdefghijkl
COOKIE_SECURE=false

# --------------------------------------------- pilha em contêiner (compose)
# Usadas por infra/compose/docker-compose.yml. No ambiente local os serviços
# expostos usam portas alternativas para não conflitar com instalações
# existentes na máquina.
POSTGRES_PASSWORD=chiron_dev_password
POSTGRES_PORT=5433
REDIS_PASSWORD=chiron_dev_password
PROXY_PORT=8080
# URL que o usuário digita quando a pilha roda em contêiner (passa pelo proxy).
STACK_PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------ email
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=CHIRON <nao-responda@chiron.local>

LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
